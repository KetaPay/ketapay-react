{
  "name": "@ketapay/react",
  "version": "0.1.0-beta.1",
  "description": "Official React components for KetaPay checkout",
  "license": "MIT",
  "keywords": [
    "ketapay",
    "escrow",
    "payments",
    "checkout",
    "react",
    "nigeria"
  ],
  "homepage": "https://github.com/KetaPay/ketapay-react#readme",
  "bugs": {
    "url": "https://github.com/KetaPay/ketapay-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KetaPay/ketapay-react.git"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "sync-catalogue": "node scripts/sync-catalogue.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=github-actions --reporter=json --outputFile.json=reports/unit.json",
    "test:catalogue": "vitest run test/catalogue-coverage.test.ts",
    "test:report": "node scripts/test-summary.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ketapay/checkout": "^0.1.0-beta.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.5"
  }
}
